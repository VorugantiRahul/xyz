# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# AI Model Configuration
# Supports Google Gemini API key or compatible AI gateway
AI_API_KEY=
# Optional: gemini, openai, or custom (default: gemini)
AI_PROVIDER=gemini
# Optional custom model name (default: gemini-1.5-flash)
AI_MODEL=gemini-1.5-flash
